# エディタの基本設定（VS Code・Android Studio 共通）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 で日本語が化けないように BOM 付きにする
[*.ps1]
charset = utf-8-bom

[*.{bat,cmd}]
end_of_line = crlf
