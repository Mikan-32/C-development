{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows（clang-cl・デバッグ）",
      "description": "日常の開発用。Developer PowerShell for VS から実行する",
      "inherits": "base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang-cl" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux（clang・ASan＋UBSan）",
      "description": "CI と WSL2 での調査用",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "NK_ENABLE_SANITIZERS": "ON",
        "NK_WARNINGS_AS_ERRORS": "ON"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64（C 部分のビルド確認用）",
      "description": "C のコードが Android 向けにビルドできるかの確認用。APK の組み立ては Gradle で行う",
      "inherits": "base",
      "toolchainFile": "$env{ANDROID_NDK}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "NK_BUILD_TESTS": "OFF",
        "NK_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-clang", "configurePreset": "windows-clang" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ],
  "testPresets": [
    {
      "name": "windows-clang",
      "configurePreset": "windows-clang",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "ignore" }
    },
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "ignore" }
    }
  ]
}
